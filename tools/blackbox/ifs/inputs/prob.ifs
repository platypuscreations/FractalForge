; Black-box test entries for XFractint's IFS type (FractalForge, own file).
; Two-transform recorder x' = x/2 + {0, 1/2}, y' = y + 1/512 with odd probabilities.
low {
  0.5 0 0 1 0   0.001953125 0.25
  0.5 0 0 1 0.5 0.001953125 0.25
}
zero {
  0.5 0 0 1 0   0.001953125 0
  0.5 0 0 1 0.5 0.001953125 1
}
neg {
  0.5 0 0 1 0   0.001953125 -0.5
  0.5 0 0 1 0.5 0.001953125 1.5
}
allzero {
  0.5 0 0 1 0   0.001953125 0
  0.5 0 0 1 0.5 0.001953125 0
}
big {
  0.5 0 0 1 0   0.001953125 3
  0.5 0 0 1 0.5 0.001953125 1
}
p8x6 {
  0.5 0 0 1 0   0.001953125 0.5 0.5
  0 0 1 0.5 0.001953125 0.5
}
th {
  0.5 0 0 1 0   0.001953125 0.3
  0.5 0 0 1 0.5 0.001953125 0.7
}
