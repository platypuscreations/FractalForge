/* Template for the arithmetic-order search (see README in mk_*.py). Own code. */
#include <stdio.h>
#include <stdlib.h>
#define W @W@
#define H @H@
static double dt,s,r,b; static double cx0,cx1,cy0,cy1;
static unsigned char img[W*H];
@FUNCS@
static int colour(int k){ return k<999?2:3+(k-999)/1001; }
static void pix(double u,double v,int*c,int*rw){ *c=(int)((u-cx0)/(cx1-cx0)*(W-1)); *rw=(int)((cy1-v)/(cy1-cy0)*(H-1)); }
static int fdiv(long a,long m){ long q=a/m; if((a%m)&&((a<0)!=(m<0))) q--; return (int)q; }
static int segok(int x0,int y0,int x1,int y1,int c,int cmax){
  int dx=x1-x0,dy=y1-y0; int M=abs(dx)>abs(dy)?abs(dx):abs(dy);
  for(int i=0;i<=M;i++){
    int px,py; if(M==0){px=x0;py=y0;} else { px=fdiv(2L*((long)x0*M+(long)i*dx)+M,2L*M); py=fdiv(2L*((long)y0*M+(long)i*dy)+M,2L*M);} 
    if(px<0||px>=W||py<0||py>=H) continue;
    int v=img[py*W+px]; if(v<c||v>cmax) return 0;
  }
  return 1;
}
int main(int argc,char**argv){
  int N=atoi(argv[1]); double P[4]={@P@}; double C[4]={@C@};
  dt=P[0];s=P[1];r=P[2];b=P[3]; cx0=C[0];cx1=C[1];cy0=C[2];cy1=C[3];
  FILE*f=fopen("img.raw","rb"); fread(img,1,W*H,f); fclose(f);
  int cmax=colour(N-1); int best=0;
  for(int ix=0;ix<@NX@;ix++) for(int iy=0;iy<@NY@;iy++) for(int iz=0;iz<@NZ@;iz++){
    double x=1,y=1,z=1; int c0,r0,c1,r1; pix(x,z,&c0,&r0); int k;
    for(k=0;k<N;k++){
      double nx=fx(ix,x,y,z),ny=fy(iy,x,y,z),nz=fz(iz,x,y,z); x=nx;y=ny;z=nz;
      pix(x,z,&c1,&r1);
      if(!segok(c0,r0,c1,r1,colour(k),cmax)) break;
      c0=c1;r0=r1;
    }
    if(k>=best-200){ printf("%d X%d Y%d Z%d\n",k,ix,iy,iz); if(k>best) best=k; }
  }
}
