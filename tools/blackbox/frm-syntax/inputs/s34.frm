cch {
  # hash
  z = 0, k = 210:
  z = z + 1
  real(z) <= real(k)
}
ccsl {
  // slashes
  z = 0, k = 211:
  z = z + 1
  real(z) <= real(k)
}
ccap {
  ' apostrophe
  z = 0, k = 212:
  z = z + 1
  real(z) <= real(k)
}
ccrem {
  rem remark
  z = 0, k = 213:
  z = z + 1
  real(z) <= real(k)
}
ccbang {
  ! bang
  z = 0, k = 214:
  z = z + 1
  real(z) <= real(k)
}
