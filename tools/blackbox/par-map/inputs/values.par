; Value-syntax probes. Base image: julia -0.8/0.156, 400x300.
paramsfirst {
  params=-0.8/0.156 corners=-1.5/1.5/-1.125/1.125 type=julia maxiter=200
}
cornersfirst {
  corners=-1.5/1.5/-1.125/1.125 type=julia params=-0.8/0.156 maxiter=200
}
bothcorncm {
