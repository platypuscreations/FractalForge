}
bothcmcorn {
  type=julia params=-0.8/0.156 maxiter=200 center-mag=0.1/0.2/2 corners=-1.5/1.5/-1.125/1.125
}
numexp {
  type=julia params=-8e-1/1.56E-1 maxiter=2e2 corners=-1.5e0/15e-1/-1.125/+1.125
}
numdot {
